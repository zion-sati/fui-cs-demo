<Project Sdk="NetWasm.Sdk/0.10.6">

  <!-- The advanced route: an application of its own, loaded at /advanced/. -->
  <PropertyGroup>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page</NetWasmJavaScriptHosts>
    <TargetFramework>netwasm0.1</TargetFramework>
    <NetWasmOptimization>Oz</NetWasmOptimization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FuiCsDemo.Advanced</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FuiCs" Version="0.3.0" />
    <ProjectReference Include="../../Shared/FuiCsDemo.Shared.csproj" />
  </ItemGroup>

  <!-- The prime worker publishes with the route, into workers/FuiCsDemo.AdvancedWorker/, sharing its runtime. -->
  <ItemGroup>
    <ProjectReference Include="../AdvancedWorker/FuiCsDemo.AdvancedWorker.csproj" NetWasmWorker="true" />
  </ItemGroup>

</Project>

<Project Sdk="NetWasm.Sdk/0.10.6">

  <!-- The advanced controls route: an application of its own, loaded at /advanced-controls/. -->
  <PropertyGroup>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page</NetWasmJavaScriptHosts>
    <TargetFramework>netwasm0.1</TargetFramework>
    <NetWasmOptimization>Oz</NetWasmOptimization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FuiCsDemo.AdvancedControls</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FuiCs" Version="0.3.0" />
    <ProjectReference Include="../../Shared/FuiCsDemo.Shared.csproj" />
  </ItemGroup>

  <!-- The prime worker publishes with the route, into workers/FuiCsDemo.AdvancedControlsWorker/, sharing its runtime. -->
  <ItemGroup>
    <ProjectReference Include="../AdvancedControlsWorker/FuiCsDemo.AdvancedControlsWorker.csproj" NetWasmWorker="true" />
  </ItemGroup>

</Project>

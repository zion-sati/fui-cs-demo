<Project Sdk="NetWasm.Sdk/0.10.7">

  <!-- The demo's home route, and the site: dotnet publish -c Release -o site writes every route to site/,
       each into the folder its path names. -->
  <PropertyGroup>
    <OutputType>JsModule</OutputType>
    <NetWasmJavaScriptHosts>page</NetWasmJavaScriptHosts>
    <TargetFramework>netwasm0.1</TargetFramework>
    <NetWasmOptimization>Oz</NetWasmOptimization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FuiCsDemo</RootNamespace>
    <FuiCsHomeTitle>Home</FuiCsHomeTitle>
    <!-- The home page offers the debug dialog (Meta+Shift+F12), which a Release build keeps off unless asked. -->
    <FuiCsDevToolsDomMirror>on-requested</FuiCsDevToolsDomMirror>
    <!-- The other routes and the shared library are projects of their own. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Routes/**;Shared/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FuiCs" Version="0.4.1" />
    <ProjectReference Include="Shared/FuiCsDemo.Shared.csproj" />
  </ItemGroup>

  <!-- The other routes: add a project under Routes/ and list it here, with the path in Shared/DemoRoutes.cs. -->
  <ItemGroup>
    <FuiCsRoute Include="Routes/TextFonts/FuiCsDemo.TextFonts.csproj" RoutePath="/text-fonts/" Title="Text &amp; Fonts" />
    <FuiCsRoute Include="Routes/Advanced/FuiCsDemo.Advanced.csproj" RoutePath="/advanced/" Title="Advanced" />
    <FuiCsRoute Include="Routes/ImmediateDrawing/FuiCsDemo.ImmediateDrawing.csproj" RoutePath="/immediate-drawing/" Title="Immediate Drawing" />
  </ItemGroup>

  <!-- DejaVu Sans, with its license, for the text and fonts route's custom-font sample, beside the runtime's fonts. -->
  <ItemGroup>
    <Content Include="assets/fonts/*" Link="fonts/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
